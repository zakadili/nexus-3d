DATABASE_URL=postgresql://nexus:change_me@db:5432/nexus
SPAMHAUS_USER=
SPAMHAUS_PASSWORD=
SPAMHAUS_TOKEN=
PUBLIC_REBROADCAST=false
ALLOWED_ORIGINS=https://zakadili.github.io
IODA_INTERVAL_SECONDS=300
# Legacy IODA collection/replay is also disabled until actual permission is recorded.
IODA_REPUBLICATION_APPROVED=false
KEV_INTERVAL_SECONDS=86400

# NEXUS LIVE remains off until source terms, a narrow scope and capacity are approved.
LIVE_PUBLIC_BASE_URL=https://nexus-193-26-115-37.sslip.io
LIVE_BGP_ENABLED=false
LIVE_RIS_TERMS_ACCEPTED=false
LIVE_BGP_CAPACITY_APPROVED=false
LIVE_BGP_COLLECTOR=
LIVE_BGP_PREFIXES=
LIVE_BGP_PATH_ASN=
LIVE_ASN_MAPPING_PATH=
# Set the actual Caddy-to-container peer IP before production activation. Never '*'.
# With Docker's loopback port publish, this may be the bridge gateway, not 127.0.0.1.
LIVE_TRUSTED_PROXY_IPS=127.0.0.1,::1
# IODA and CT have no enable flag: data rights/capacity are still unresolved.

